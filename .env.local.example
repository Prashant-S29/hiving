# Sanity project — get these after running `npm create sanity@latest` or from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Emergency-only production override. Keep false so CMS failures are visible
# instead of silently serving development fixtures/defaults.
SANITY_ALLOW_FALLBACKS=false

# Read-only Viewer token used only for authenticated draft preview/visual editing.
SANITY_API_READ_TOKEN=

# Shared secret used to verify Sanity publish webhooks sent to /api/revalidate.
SANITY_REVALIDATE_SECRET=

# Frontend URL loaded inside Sanity Presentation. Use http://localhost:3000 locally.
SANITY_STUDIO_PREVIEW_ORIGIN=http://localhost:3000

# Optional: a write token, only needed for trusted server-side writes or migration scripts.
SANITY_API_WRITE_TOKEN=

# UnoSend transactional email delivery.
# EMAIL_PROVIDER_API_KEY remains a temporary fallback for UNOSEND_API_KEY.
UNOSEND_API_KEY=
EMAIL_PROVIDER_API_KEY=
UNOSEND_FROM_EMAIL="Hivig <hello@hivig.com>"
UNOSEND_NOTIFICATION_EMAIL=

# Powers /agents/discover's live feasibility-study generation (lib/feasibility.ts).
# Get one at console.anthropic.com. Without it, /agents/discover shows its
# CMS-managed fallback error; the plain /agents quote form still works.
ANTHROPIC_API_KEY=
