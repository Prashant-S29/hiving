# Sanity project — get these after running `npm create sanity@latest` or from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: a write token, only needed if you later add server-side writes (e.g. comments, votes)
SANITY_API_WRITE_TOKEN=

# Subscribe form — wire this to your email provider when ready (e.g. Resend, ConvertKit, Beehiiv)
EMAIL_PROVIDER_API_KEY=

# Powers /agents/discover's live feasibility-study generation (lib/feasibility.ts).
# Get one at console.anthropic.com. Without it, /agents/discover shows a clear
# config error; the plain /agents quote form still works without this key.
ANTHROPIC_API_KEY=
